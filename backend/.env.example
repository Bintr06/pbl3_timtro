SPRING_PROFILES_ACTIVE=prod

DB_URL=jdbc:mysql://<aiven-host>:<aiven-port>/<db-name>?sslMode=REQUIRED&serverTimezone=UTC
DB_USERNAME=<aiven-username>
DB_PASSWORD=<aiven-password>

JWT_SECRET_KEY=<base64-encoded-secret-at-least-32-bytes>

CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<smtp-username>
MAIL_PASSWORD=<smtp-app-password>

APP_CORS_ALLOWED_ORIGINS=https://<your-frontend-domain>
