# Development Configuration Template
# Copy this file to application-dev.properties and fill in YOUR OWN values
# DO NOT commit application-dev.properties to git (it's ignored)

# Database Configuration
spring.datasource.url=${DB_URL:jdbc:mysql://localhost:3306/pbl3_timtro?createDatabaseIfNotExist=true}
spring.datasource.username=${DB_USERNAME:root}
spring.datasource.password=${DB_PASSWORD:root}
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true

# JWT Secret Key (min 32 characters, base64 encoded)
security.jwt.secret-key=${JWT_SECRET_KEY:MDEyMzQ1Njc4OUFCQ0RFRjAxMjM0NTY3ODlBQkNERUY=}
security.jwt.access-expiration-ms=${JWT_ACCESS_EXPIRATION_MS:900000}
security.jwt.refresh-expiration-ms=${JWT_REFRESH_EXPIRATION_MS:2592000000}

# Refresh token cleanup scheduler
app.auth.refresh-token.cleanup.fixed-delay-ms=${REFRESH_TOKEN_CLEANUP_FIXED_DELAY_MS:21600000}
app.auth.refresh-token.cleanup.initial-delay-ms=${REFRESH_TOKEN_CLEANUP_INITIAL_DELAY_MS:120000}

# Cloudinary Configuration (for image storage)
cloudinary.cloud-name=${CLOUDINARY_CLOUD_NAME:your-cloudinary-cloud-name}
cloudinary.api-key=${CLOUDINARY_API_KEY:your-cloudinary-api-key}
cloudinary.api-secret=${CLOUDINARY_API_SECRET:your-cloudinary-api-secret}

# Email Configuration (Gmail with app password)
spring.mail.host=${MAIL_HOST:smtp.gmail.com}
spring.mail.port=${MAIL_PORT:587}
spring.mail.username=${MAIL_USERNAME:your-email@gmail.com}
spring.mail.password=${MAIL_PASSWORD:your-gmail-app-password}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

# CORS Configuration (allowed frontend origins)
app.cors.allowed-origins=${APP_CORS_ALLOWED_ORIGINS:http://localhost:3000,http://localhost:5173}

# Google OAuth Configuration
google.oauth.client-id=${GOOGLE_OAUTH_CLIENT_ID:your-google-web-client-id.apps.googleusercontent.com}
